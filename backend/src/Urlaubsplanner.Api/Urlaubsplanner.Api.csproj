<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- API-Keys liegen in den .NET User Secrets (außerhalb des Repos): dotnet user-secrets set "LiteApi:ApiKey" "…" -->
    <UserSecretsId>urlaubsplanner-api-3f6c1d2e</UserSecretsId>
  </PropertyGroup>

  <!-- Desktop-App für Windows (packaging/build-app.sh windows): kein Konsolenfenster, eigenes Icon. Nur für dieses Projekt,
       deshalb nicht direkt als -p:OutputType übergeben (das würde auch die Bibliotheken treffen). -->
  <PropertyGroup Condition="'$(DesktopWindows)' == 'true'">
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>..\..\..\packaging\icons\Urlaubsplanner.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Urlaubsplanner.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Urlaubsplanner.Domain\Urlaubsplanner.Domain.csproj" />
    <ProjectReference Include="..\Urlaubsplanner.Infrastructure\Urlaubsplanner.Infrastructure.csproj" />
  </ItemGroup>

</Project>
